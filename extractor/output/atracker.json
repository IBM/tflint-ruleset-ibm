{
  "package": "atracker",
  "resources": [
    {
      "name": "ibm_atracker_route",
      "function": "ResourceIBMAtrackerRoute",
      "package": "atracker",
      "kind": "resource",
      "description": "Manages ibm_atracker_route. The name of the route.",
      "attributes": {
        "api_version": {
          "name": "api_version",
          "type": "int",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "The API version of the route."
        },
        "created_at": {
          "name": "created_at",
          "type": "string",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "The timestamp of the route creation time."
        },
        "crn": {
          "name": "crn",
          "type": "string",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "The crn of the route resource.",
          "validate": {
            "kind": "crn",
            "func_name": "name_heuristic"
          }
        },
        "managed_by": {
          "name": "managed_by",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "force_new": true,
          "description": "Present when the route is enterprise-managed (`managed_by: enterprise`).",
          "default": "account",
          "validate": {
            "kind": "enum",
            "func_name": "ValidateAllowedStringValue",
            "enum": [
              "account",
              "enterprise"
            ]
          }
        },
        "message": {
          "name": "message",
          "type": "string",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "An optional message containing information about the route."
        },
        "name": {
          "name": "name",
          "type": "string",
          "required": true,
          "optional": false,
          "computed": false,
          "description": "The name of the route.",
          "validate": {
            "kind": "regexp",
            "func_name": "ValidateRegexpLen",
            "min_len": 1,
            "max_len": 1000,
            "regexp": "^[a-zA-Z0-9 -._:]+$"
          }
        },
        "rules": {
          "name": "rules",
          "type": "list",
          "required": true,
          "optional": false,
          "computed": false,
          "description": "The routing rules that will be evaluated in their order of the array. Once a rule is matched, the remaining rules in the route definition will be skipped.",
          "elem": {
            "kind": "resource",
            "attributes": {
              "locations": {
                "name": "locations",
                "type": "list",
                "required": true,
                "optional": false,
                "computed": false,
                "description": "Logs from these locations will be sent to the targets specified. Locations is a superset of regions including global and *.",
                "elem": {
                  "kind": "schema",
                  "type": "string"
                }
              },
              "target_ids": {
                "name": "target_ids",
                "type": "list",
                "required": true,
                "optional": false,
                "computed": false,
                "description": "The target ID List. All the events will be send to all targets listed in the rule. You can include targets from other regions.",
                "elem": {
                  "kind": "schema",
                  "type": "string"
                }
              }
            }
          }
        },
        "updated_at": {
          "name": "updated_at",
          "type": "string",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "The timestamp of the route last updated time."
        },
        "version": {
          "name": "version",
          "type": "int",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "The version of the route."
        }
      },
      "validators": [
        {
          "identifier": "managed_by",
          "kind": "ValidateAllowedStringValue",
          "allowed": "account, enterprise"
        },
        {
          "identifier": "name",
          "kind": "ValidateRegexpLen",
          "regexp": "^[a-zA-Z0-9 -._:]+$",
          "min_len": 1,
          "max_len": 1000
        }
      ]
    },
    {
