{
  "package": "cloudfoundry",
  "resources": [
    {
      "name": "ibm_app",
      "function": "ResourceIBMApp",
      "package": "cloudfoundry",
      "kind": "resource",
      "description": "Manages ibm_app. The name for the app",
      "attributes": {
        "app_path": {
          "name": "app_path",
          "type": "string",
          "required": true,
          "optional": false,
          "computed": false,
          "description": "Define the  path of the zip file of the application."
        },
        "app_version": {
          "name": "app_version",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Version of the application"
        },
        "buildpack": {
          "name": "buildpack",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Buildpack to build the app. 3 options: a) Blank means autodetection; b) A Git Url pointing to a buildpack; c) Name of an installed buildpack."
        },
        "command": {
          "name": "command",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "The initial command for the app"
        },
        "disk_quota": {
          "name": "disk_quota",
          "type": "int",
          "required": false,
          "optional": true,
          "computed": true,
          "description": "The maximum amount of disk available to an instance of an app. In megabytes."
        },
        "environment_json": {
          "name": "environment_json",
          "type": "map",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Key/value pairs of all the environment variables to run in your app. Does not include any system or service variables."
        },
        "health_check_http_endpoint": {
          "name": "health_check_http_endpoint",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Endpoint called to determine if the app is healthy."
        },
        "health_check_timeout": {
          "name": "health_check_timeout",
          "type": "int",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Timeout in seconds for health checking of an staged app when starting up."
        },
        "health_check_type": {
          "name": "health_check_type",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Type of health check to perform.",
          "default": "port",
          "validate": {
            "kind": "enum",
            "func_name": "ValidateAllowedStringValues",
            "enum": [
              "port",
              "process"
            ]
          }
        },
        "instances": {
          "name": "instances",
          "type": "int",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "The number of instances",
          "default": "1"
        },
        "memory": {
          "name": "memory",
          "type": "int",
          "required": false,
          "optional": true,
          "computed": true,
          "description": "The amount of memory each instance should have. In megabytes."
        },
        "name": {
          "name": "name",
          "type": "string",
          "required": true,
          "optional": false,
          "computed": false,
          "description": "The name for the app"
        },
        "route_guid": {
          "name": "route_guid",
          "type": "set",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Define the route guids which should be bound to the application.",
          "elem": {
            "kind": "schema",
            "type": "string"
          }
        },
        "service_instance_guid": {
          "name": "service_instance_guid",
          "type": "set",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Define the service instance guids that should be bound to this application.",
          "elem": {
            "kind": "schema",
            "type": "string"
          }
        },
        "space_guid": {
          "name": "space_guid",
          "type": "string",
          "required": true,
          "optional": false,
          "computed": false,
          "force_new": true,
          "description": "Define space guid to which app belongs"
        },
        "tags": {
          "name": "tags",
          "type": "set",
          "required": false,
          "optional": true,
          "computed": false,
          "elem": {
            "kind": "schema",
            "type": "string"
          }
        },
        "wait_time_minutes": {
          "name": "wait_time_minutes",
          "type": "int",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "Define timeout to wait for the app instances to start/update/restage etc.",
          "default": "20"
        }
      }
    },
