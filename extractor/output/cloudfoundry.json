    {
      "name": "ibm_app_route",
      "function": "ResourceIBMAppRoute",
      "package": "cloudfoundry",
      "kind": "resource",
      "description": "Schema validation for the ibm_app_route resource.",
      "attributes": {
        "domain_guid": {
          "name": "domain_guid",
          "type": "string",
          "required": true,
          "optional": false,
          "computed": false,
          "force_new": true,
          "description": "The guid of the associated domain"
        },
        "host": {
          "name": "host",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "The host portion of the route. Required for shared-domains."
        },
        "path": {
          "name": "path",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "The path for a route as raw text.Paths must be between 2 and 128 characters.Paths must start with a forward slash '/'.Paths must not contain a '?'",
          "validate": {
            "kind": "func",
            "func_name": "ValidateRoutePath"
          }
        },
        "port": {
          "name": "port",
          "type": "int",
          "required": false,
          "optional": true,
          "computed": false,
          "description": "The port of the route. Supported for domains of TCP router groups only.",
          "validate": {
            "kind": "port",
            "func_name": "ValidateRoutePort",
            "min": 1,
            "max": 65535
          }
        },
        "space_guid": {
          "name": "space_guid",
          "type": "string",
          "required": true,
          "optional": false,
          "computed": false,
          "force_new": true,
          "description": "The guid of the associated space"
        },
        "tags": {
          "name": "tags",
          "type": "set",
          "required": false,
          "optional": true,
          "computed": false,
          "elem": {
            "kind": "schema",
            "type": "string"
          }
        }
      }
    },
