    {
      "name": "ibm_logs_router_route",
      "function": "ResourceIBMLogsRouterRoute",
      "package": "logsrouter",
      "kind": "resource",
      "description": "Manages ibm_logs_router_route. The name of the route.",
      "attributes": {
        "created_at": {
          "name": "created_at",
          "type": "string",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "The timestamp of the route creation time."
        },
        "crn": {
          "name": "crn",
          "type": "string",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "The crn of the route resource.",
          "validate": {
            "kind": "crn",
            "func_name": "name_heuristic"
          }
        },
        "managed_by": {
          "name": "managed_by",
          "type": "string",
          "required": false,
          "optional": true,
          "computed": false,
          "force_new": true,
          "description": "Identifies who manages the target.",
          "default": "account",
          "validate": {
            "kind": "enum",
            "func_name": "ValidateAllowedStringValue",
            "enum": [
              "account",
              "enterprise"
            ]
          }
        },
        "name": {
          "name": "name",
          "type": "string",
          "required": true,
          "optional": false,
          "computed": false,
          "description": "The name of the route.",
          "validate": {
            "kind": "regexp",
            "func_name": "ValidateRegexpLen",
            "min_len": 1,
            "max_len": 1000,
            "regexp": "^[a-zA-Z0-9 \\-._:]+$"
          }
        },
        "rules": {
          "name": "rules",
          "type": "list",
          "required": true,
          "optional": false,
          "computed": false,
          "description": "The routing rules that will be evaluated in their order of the array. Once a rule is matched, the remaining rules in the route definition will be skipped.",
          "elem": {
            "kind": "resource",
            "attributes": {
              "action": {
                "name": "action",
                "type": "string",
                "required": false,
                "optional": true,
                "computed": false,
                "description": "The action if the inclusion_filters matches, default is `send` action."
              },
              "inclusion_filters": {
                "name": "inclusion_filters",
                "type": "list",
                "required": false,
                "optional": true,
                "computed": false,
                "description": "A list of conditions to be satisfied for routing platform logs to pre-defined target.",
                "elem": {
                  "kind": "resource",
                  "attributes": {
                    "operand": {
                      "name": "operand",
                      "type": "string",
                      "required": true,
                      "optional": false,
                      "computed": false,
                      "description": "Part of CRN that can be compared with values. Currently only location is supported."
                    },
                    "operator": {
                      "name": "operator",
                      "type": "string",
                      "required": true,
                      "optional": false,
                      "computed": false,
                      "description": "The operation to be performed between operand and the provided values. 'is' to be used with one value and 'in' can support up to 20 values in the array."
                    },
                    "values": {
                      "name": "values",
                      "type": "list",
                      "required": true,
                      "optional": false,
                      "computed": false,
                      "description": "The provided string values of the operand to be compared with.",
                      "elem": {
                        "kind": "schema",
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "targets": {
                "name": "targets",
                "type": "list",
                "required": true,
                "optional": false,
                "computed": false,
                "description": "The target ID List. Platform logs will be sent to all targets listed in the rule. You can include targets from other regions.",
                "elem": {
                  "kind": "resource",
                  "attributes": {
                    "id": {
                      "name": "id",
                      "type": "string",
                      "required": true,
                      "optional": false,
                      "computed": false,
                      "description": "The target uuid for a pre-defined platform logs router target."
                    }
                  }
                }
              }
            }
          }
        },
        "updated_at": {
          "name": "updated_at",
          "type": "string",
          "required": false,
          "optional": false,
          "computed": true,
          "description": "The timestamp of the route last updated time."
        }
      },
      "validators": [
        {
          "identifier": "managed_by",
          "kind": "ValidateAllowedStringValue",
          "allowed": "account, enterprise"
        },
        {
          "identifier": "name",
          "kind": "ValidateRegexpLen",
          "regexp": "^[a-zA-Z0-9 \\-._:]+$",
          "min_len": 1,
          "max_len": 1000
        }
      ]
    },
